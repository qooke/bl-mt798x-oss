sd_boot=
mmc dev 0;
if mmc rescan; then
    if fatload mmc 0:1 ${kernel_addr_r} openwrt.itb; then
        echo Boot FIT (DTS bootargs);
        env delete bootargs;
        bootm ${kernel_addr_r};
    else
        echo Boot legacy zImage (DTS bootargs);
        env delete bootargs;
        fatload mmc 0:1 ${kernel_addr_r} zImage;
        fatload mmc 0:1 ${fdt_addr_r} xxx.dtb;
        bootz ${kernel_addr_r} - ${fdt_addr_r};
    fi;
fi
