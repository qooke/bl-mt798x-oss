/dts-v1/;
#include "mt7981.dtsi"
#include <dt-bindings/gpio/gpio.h>


/ {
	#address-cells = <1>;
	#size-cells = <1>;
	
	model = "MelonPi M81 Pro";
	compatible = "mediatek,mt7981", "mediatek,mt7981-rfb";
	
	chosen {
		stdout-path = &uart0;
		tick-timer = &timer0;
	};
	
	memory@40000000 {
		device_type = "memory";
		reg = <0x40000000 0x20000000>;
	};
	
	config {
		bootcmd = "mtkboardboot";
		blink_led = "green:status";
		system_led = "green:status";
	};
	
	gpio-keys {
		compatible = "gpio-keys";
		
		button-wps {
			label = "wps";
			gpios = <&pio 0 GPIO_ACTIVE_LOW>;
		};
		
		button-reset {
			label = "reset";
			gpios = <&pio 1 GPIO_ACTIVE_LOW>;
		};
	};
	
	gpio-leds {
		compatible = "gpio-leds";
		
		led-0 {
			label = "red:power";
			gpios = <&pio 9 GPIO_ACTIVE_LOW>;
		};
		
		led-1 {
			label = "red:wlan";
			gpios = <&pio 12 GPIO_ACTIVE_LOW>;
		};
		
		status_led: led-2 {
			label = "green:status";
			gpios = <&pio 13 GPIO_ACTIVE_LOW>;
		};
	};

	bl2_verify {
		bl2_compatible = "spim-nand";
	};
};

&eth {
	status = "okay";
	mediatek,gmac-id = <1>;
	phy-mode = "gmii";
	phy-handle = <&phy0>;

	phy0: ethernet-phy@0 {
		compatible = "ethernet-phy-id03a2.9461";
		reg = <0x0>;
		phy-mode = "gmii";
	};
};

&pio {
	spi_flash_pins: spi0-pins-func-1 {
		mux {
			function = "flash";
			groups = "spi0", "spi0_wp_hold";
		};

		conf-pu {
			pins = "SPI0_CS", "SPI0_HOLD", "SPI0_WP";
			drive-strength = <MTK_DRIVE_4mA>;
			bias-pull-up = <MTK_PUPD_SET_R1R0_11>;
		};

		conf-pd {
			pins = "SPI0_CLK", "SPI0_MOSI", "SPI0_MISO";
			drive-strength = <MTK_DRIVE_4mA>;
			bias-pull-down = <MTK_PUPD_SET_R1R0_11>;
		};
	};

	pwm1_pins: pwm1-pins-func-1 {
		mux {
			function = "pwm";
			groups = "pwm1";
		};
	};
};

&spi0 {
	#address-cells = <1>;
	#size-cells = <0>;
	pinctrl-names = "default";
	pinctrl-0 = <&spi_flash_pins>;
	status = "okay";
	must_tx;
	enhance_timing;
	dma_ext;
	ipm_design;
	support_quad;
	tick_dly = <2>;
	sample_sel = <0>;
	
	spi_nand@0 {
		compatible = "spi-nand";
		reg = <0>;
		spi-max-frequency = <52000000>;
		spi-rx-bus-width = <4>;
		spi-tx-bus-width = <4>;		
	};
};

&pwm {
	pinctrl-names = "default";
	pinctrl-0 = <&pwm1_pins>;
	status = "okay";
};

&uart0 {
	status = "okay";
};

&watchdog {
	status = "disabled";
};
